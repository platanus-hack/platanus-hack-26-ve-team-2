{
  "expo": {
    "name": "Platanus AR",
    "slug": "platanus-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "platanusar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "com.arvi.app",
      "version": "1.1.0",
      "buildNumber": "2",
      "appleTeamId": "MYV6MKFDJ5",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "ARVI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.platanushack.ar",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "provider": "none",
          "ios": {
            "cameraUsagePermission": "Usamos la cámara para mostrar la experiencia de realidad aumentada."
          },
          "android": {
            "xRMode": [
              "AR"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para activar experiencias AR en zonas cercanas."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Usamos el micrófono para que puedas hacerle preguntas a los personajes históricos.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para mostrar la experiencia de realidad aumentada.",
          "microphonePermission": "Usamos el micrófono para que puedas hacerle preguntas a los personajes históricos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
